{
  "name": "kanban",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "cli",
    "web",
    "server"
  ],
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:web": "vitest --project web",
    "test:cli": "vitest --project cli",
    "test:server": "vitest --project server",
    "test:coverage": "vitest run --coverage",
    "dev": "npm run dev --workspace=web",
    "cli": "node cli/bin/kanban.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"web/src/**/*.{css,vue}\"",
    "lint:css:fix": "stylelint \"web/src/**/*.{css,vue}\" --fix",
    "lint:all": "npm run lint && npm run lint:css",
    "build": "npm run build --workspace=web",
    "start": "node server/src/index.js",
    "start:https": "HTTPS=true node server/src/index.js",
    "lint:all:fix": "npm run lint:fix && npm run lint:css:fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-use-logical": "^2.1.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
